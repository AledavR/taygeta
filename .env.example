# ============================================================================
# Taygeta — variables de entorno de ejemplo (sección 11.5).
# Copia este archivo a `.env` y completa los valores en el despliegue.
# El archivo `.env` real NO debe versionarse.
# ============================================================================

# LLM remoto para estructuración y validación. Completar en el despliegue.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# OCR local mediante una API compatible con OpenAI.
OCR_API_KEY=local-ocr
OCR_BASE_URL=http://ocr:8080/v1
OCR_MODEL=Qwen2-VL-7B-Instruct-Q4_K_M
# Rutas dentro del volumen persistente 'ocr-models'. Si no existen, se descargan
# automáticamente desde las URLs indicadas (Hugging Face).
OCR_MODEL_PATH=/models/Qwen2-VL-7B-Instruct-Q4_K_M.gguf
OCR_MMPROJ_PATH=/models/mmproj-Qwen2-VL-7B-Instruct-f16.gguf
OCR_MODEL_URL=https://huggingface.co/bartowski/Qwen2-VL-7B-Instruct-GGUF/resolve/main/Qwen2-VL-7B-Instruct-Q4_K_M.gguf
OCR_MMPROJ_URL=https://huggingface.co/bartowski/Qwen2-VL-7B-Instruct-GGUF/resolve/main/mmproj-Qwen2-VL-7B-Instruct-f16.gguf
OCR_TIMEOUT_SECONDS=180
OCR_CONTEXT_SIZE=8192
OCR_CONCURRENCY=1
OCR_THREADS=
OCR_PORT=8080

# SQLite y directorios runtime.
DB_PATH=/app/data/taygeta.db
DOWNLOADS_DIR=/app/downloads
UPLOADS_DIR=/app/uploads
DOWNLOADS_TTL_SECONDS=3600

# SeaweedFS mediante API S3.
# Las credenciales deben coincidir con docker/seaweedfs/s3.json.example.
S3_ENDPOINT_URL=http://seaweedfs-s3:8333
S3_BUCKET=taygeta-assets
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_REGION=us-east-1
ASSET_PUBLIC_BASE_URL=
ASSET_URL_TTL_SECONDS=300

# Direcciones públicas de los servicios, configurables para cada despliegue.
MCP_HOST=0.0.0.0
MCP_PORT=8000
STREAMLIT_PUBLIC_URL=http://localhost:8501
DOWNLOAD_PUBLIC_URL=http://localhost:8000

# Override ROCm: solo se aplica a docker-compose.rocm.yml.
# Puede dejarse vacío o eliminarse si la versión instalada detecta la
# arquitectura correctamente sin override.
HSA_OVERRIDE_GFX_VERSION=10.3.0

# Override CUDA: selección de dispositivos NVIDIA (opcional).
# Ejemplos: "all", "0", "0,1" o usar device_ids en docker-compose.cuda.yml.
NVIDIA_VISIBLE_DEVICES=all
