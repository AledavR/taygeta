# syntax=docker/dockerfile:1
#
# Servicio OCR — variante NVIDIA/CUDA (sección 11.3).
# Construye `llama-server` con backend CUDA y lo ejecuta sobre el runtime CUDA.
#
# Requisitos del host:
#   - Driver NVIDIA y NVIDIA Container Toolkit instalados y configurados.
#   - `docker run --rm --gpus all nvidia/cuda:12.4.1-base-ubuntu22.04 nvidia-smi`
#     debe listar la GPU antes de levantar el stack.
# Verificación: `docker compose -f docker-compose.yml -f docker-compose.cuda.yml \
#   exec ocr llama-server --list-devices` (debe detectar la GPU NVIDIA).

FROM nvidia/cuda:12.4.1-devel-ubuntu22.04 AS build

ARG LLAMA_CPP_REF=b11559
# Arquitecturas CUDA a compilar; ajústalas a las GPUs del despliegue.
ARG CUDA_ARCHITECTURES="61;70;75;80;86;89"
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      git cmake build-essential ca-certificates libcurl4-openssl-dev \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone --depth 1 --branch "${LLAMA_CPP_REF}" https://github.com/ggml-org/llama.cpp.git .
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release \
      -DGGML_CUDA=ON -DGGML_HIP=OFF \
      -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES}" -DLLAMA_CURL=ON \
 && cmake --build build --config Release -j"$(nproc)" --target llama-server

# ---------------------------------------------------------------------------
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04 AS runtime

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      libgomp1 libcurl4 ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /src/build/bin/llama-server /usr/local/bin/llama-server
# Bibliotecas compartidas de llama.cpp (p. ej. libllama-server-impl.so).
COPY --from=build /src/build/bin/*.so* /usr/local/lib/
COPY docker/ocr/entrypoint.sh /usr/local/bin/ocr-entrypoint
RUN chmod 0755 /usr/local/bin/ocr-entrypoint && ldconfig

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/ocr-entrypoint"]
